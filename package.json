{
  "name": "astrox",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-db.mjs next dev --port 3000",
    "build": "node scripts/with-db.mjs next build",
    "start": "node scripts/with-db.mjs next start --port 3000",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "node scripts/with-db.mjs prisma db push --accept-data-loss",
    "db:seed": "node scripts/with-db.mjs tsx prisma/seed.ts",
    "test": "node scripts/with-db.mjs vitest run"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "2.30.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.6.1",
    "react-icons": "5.7.0",
    "zod": "^3.24.2",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "prisma": "5.22.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "vitest": "^3.0.7"
  }
}
