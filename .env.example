# Astrox PostgreSQL 17 connection
# Option A (Zero-root auto-managed PostgreSQL 17 cluster in .pgdata):
DATABASE_URL="postgresql://astrox@localhost/astrox?host=/tmp"
DIRECT_URL="postgresql://astrox@localhost/astrox?host=/tmp"
# Option B (Neon Serverless PostgreSQL):
# DATABASE_URL="postgresql://[user]:[password]@ep-curly-violet-56824599-pooler.[region].aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://[user]:[password]@ep-curly-violet-56824599.[region].aws.neon.tech/neondb?sslmode=require"

# Authentication & Security
AUTH_SECRET="replace-with-32-byte-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google OAuth (optional - falls back to setup notice until configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Provider Modes (mock | sandbox | live)
BKASH_MODE="mock"
NAGAD_MODE="mock"
SSLCOMMERZ_MODE="mock"
STRIPE_MODE="mock"
PATHAO_MODE="mock"
STEADFAST_MODE="mock"
REDX_MODE="mock"
SMS_MODE="mock"
SMTP_MODE="mock"
